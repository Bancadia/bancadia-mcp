{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ES2022",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
    "src/**/*.test.ts",
    // Imports `cloudflare:test` (the vitest-pool-workers ambient module),
    // same reason *.test.ts is excluded above — that module only resolves
    // inside the Vitest pool, not under this root tsconfig.
    "src/__tests__/integration/db-helpers.ts",
    // Dead code, unrouted in src/index.ts pending deletion — built against a schema
    // predating the hybrid-schema redesign and no longer compiles against the typed
    // Supabase client. Do not fix in place; delete these alongside their handlers.
    "src/handlers/query-hysa.ts",
    "src/handlers/query-personal-savings.ts",
    "src/handlers/query-personal-checking.ts",
    "src/handlers/query-personal-cd.ts",
    "src/handlers/query-business-savings.ts",
    "src/handlers/query-business-cd.ts"
  ]
}
